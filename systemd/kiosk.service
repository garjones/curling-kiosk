# kiosk.service — written to /etc/systemd/system by kiosk-deploy, which
# fills in @USER@ and @HOME@ for this Pi's login user.
[Unit]
Description=Curling kiosk display
Wants=graphical.target
After=graphical.target

[Service]
Environment=DISPLAY=:0.0
Environment=XAUTHORITY=@HOME@/.Xauthority
Type=simple
ExecStart=/usr/local/bin/kiosk-run
Restart=on-abort
RestartSec=5
User=@USER@
Group=@GROUP@

[Install]
WantedBy=graphical.target
