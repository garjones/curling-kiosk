# secrets.env — the camera login, and nothing else.
#
# In the club's site repo this file is committed ONLY encrypted, as
# kiosk/secrets.env.age, to the club machine key (and optionally a
# maintainer's own key):
#
#     age -R machine.pub -o kiosk/secrets.env.age kiosk/secrets.env
#
# The plain secrets.env must be gitignored there and must never enter
# this (public) product repo. kiosk-deploy decrypts it on each Pi into
# /etc/kiosk/secrets.env, readable only by root and the kiosk user.
#
# Plain KEY=value lines; quotes optional. Any character is fine in the
# password — it is URL-encoded before it goes into a camera URL.
CAM_USER=
CAM_PASS=
