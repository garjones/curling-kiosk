#!/bin/bash
# --------------------------------------------------------------------------------
#  kiosk-watchdog — reboot the Pi if the network has gone away.
# --------------------------------------------------------------------------------
#  Run as root every 15 minutes from /etc/cron.d/curling-kiosk. Pings
#  WATCHDOG_HOST from club.conf; if all four pings fail, logs and reboots.
#  WATCHDOG_HOST empty = do nothing. A Pi whose Wi-Fi drops usually comes
#  back cleanly after a reboot; that is all this is for.
#
#  Only failures are logged (v10 logged every run, and the file grew for
#  ever): /var/log/kiosk-watchdog.log
# --------------------------------------------------------------------------------
#  (C) Copyright Gareth Jones - gareth@gareth.com
# --------------------------------------------------------------------------------

HERE="$(dirname "$(readlink -f "$0")")"
# shellcheck source=../lib/kiosk-common.sh
. "$HERE/../lib/kiosk-common.sh"

kiosk_load_club 2>/dev/null || WATCHDOG_HOST="1.1.1.1"
[ -n "$WATCHDOG_HOST" ] || exit 0

if ! ping -c 4 -W 5 "$WATCHDOG_HOST" > /dev/null 2>&1; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $WATCHDOG_HOST unreachable, rebooting" >> /var/log/kiosk-watchdog.log
    /sbin/shutdown -r now
fi
