#!/bin/bash
# --------------------------------------------------------------------------------
#  kiosk-menu — the operator menu, shown on every SSH login to a kiosk Pi.
# --------------------------------------------------------------------------------
#  Chooses what THIS screen shows and writes /etc/kiosk/display.conf. The
#  lists (sheets, web pages) come from the club's club.conf, so the menu
#  fits any club. Quit drops to an ordinary shell.
#
#  KIOSK_NO_REBOOT=1  write the file but do not reboot (testing)
# --------------------------------------------------------------------------------
#  (C) Copyright Gareth Jones - gareth@gareth.com
# --------------------------------------------------------------------------------

set -u
HERE="$(dirname "$(readlink -f "$0")")"
# shellcheck source=../lib/kiosk-common.sh
. "$HERE/../lib/kiosk-common.sh"

VERSION="$(git -C "$HERE/.." describe --tags --always 2>/dev/null || echo dev)"
WT_HEIGHT=25
WT_WIDTH=80
WT_MENU_HEIGHT=$((WT_HEIGHT - 7))

KIOSK_ERROR=""
if ! kiosk_load_club; then
    whiptail --title "Curling kiosk" --msgbox "$KIOSK_ERROR.

This Pi has not been deployed yet. Run the installer again
(see the curling-kiosk README), then log in again." 14 70
    exit 1
fi
WT_TITLE="$CLUB_NAME kiosk ($VERSION)"
WT_BACK="$(hostname) - $(hostname -I 2>/dev/null | awk '{print $1}')"

# current settings are the defaults, so changing mode keeps the rotation
kiosk_load_display || true


# --------------------------------------------------------------------------------
# helpers
# --------------------------------------------------------------------------------
wt_menu() {   # wt_menu "prompt" "Cancel label" tag item tag item ...
    local prompt=$1 cancel=$2; shift 2
    whiptail --title "$WT_TITLE" --backtitle "$WT_BACK" --menu "$prompt" \
        $WT_HEIGHT $WT_WIDTH $WT_MENU_HEIGHT --cancel-button "$cancel" --ok-button Select \
        "$@" 3>&1 1>&2 2>&3
}

describe_current() {
    case "${MODE:-}" in
        pair)   echo "Cameras: sheets $BOTTOM (bottom) and $TOP (top)";;
        single) echo "Camera: sheet $BOTTOM";;
        web)    echo "Web page: ${WEB_NAME[WEB]:-number $WEB}";;
        *)      echo "Not set up";;
    esac
}

# save MODE TOP BOTTOM WEB — confirm, write display.conf, reboot
save() {
    local mode=$1 top=$2 bottom=$3 web=$4
    whiptail --title "$WT_TITLE" --yesno "Show this on the screen and reboot?

$(MODE=$mode TOP=$top BOTTOM=$bottom WEB=$web describe_current)
Screen: $([ "$ROTATION" = V ] && echo vertical || echo horizontal)" 14 70 || return 0
    local tmp sudo=""
    tmp=$(mktemp)
    [ -w "$KIOSK_ETC" ] || sudo=sudo   # /etc/kiosk is root's; the Pi user has sudo
    if ! printf 'MODE=%s\nROTATION=%s\nTOP=%s\nBOTTOM=%s\nWEB=%s\n' \
            "$mode" "$ROTATION" "$top" "$bottom" "$web" > "$tmp" ||
       ! $sudo install -m 644 "$tmp" "$KIOSK_ETC/display.conf"; then
        rm -f "$tmp"
        whiptail --msgbox "Could not write $KIOSK_ETC/display.conf. Nothing was changed." 10 70
        return 0
    fi
    rm -f "$tmp"
    sync
    if [ "${KIOSK_NO_REBOOT:-0}" = 1 ]; then
        echo "wrote $KIOSK_ETC/display.conf (KIOSK_NO_REBOOT=1, not rebooting)"; exit 0
    fi
    sudo reboot
}


# --------------------------------------------------------------------------------
# menus
# --------------------------------------------------------------------------------
menu_pairs() {
    local items=() a b choice
    while read -r a b; do
        items+=("C$(kiosk_2d "$a")$(kiosk_2d "$b")" "Sheets $a and $b")
    done < <(kiosk_pairs)
    if [ ${#items[@]} -eq 0 ]; then
        whiptail --msgbox "This club has only one sheet. Use Single camera." 10 60; return 0
    fi
    choice=$(wt_menu "Two sheets: lower number at the bottom" Back "${items[@]}") || return 0
    save pair "$((10#${choice:3:2}))" "$((10#${choice:1:2}))" 0
}

menu_single() {
    local items=() n choice
    for ((n = 1; n <= SHEETS; n++)); do items+=("S$(kiosk_2d "$n")" "Sheet $n"); done
    choice=$(wt_menu "One sheet" Back "${items[@]}") || return 0
    save single 0 "$((10#${choice:1:2}))" 0
}

ask_sheet() {   # ask_sheet "prompt" — prints a valid sheet number or fails
    local v
    while true; do
        v=$(whiptail --title "$WT_TITLE" --inputbox "$1 (1 to $SHEETS):" 10 60 3>&1 1>&2 2>&3) || return 1
        if [[ "$v" =~ ^[0-9]+$ ]] && [ "$((10#$v))" -ge 1 ] && [ "$((10#$v))" -le "$SHEETS" ]; then
            echo "$((10#$v))"; return 0
        fi
        whiptail --msgbox "'$v' is not a sheet number from 1 to $SHEETS." 10 60
    done
}

menu_custom() {
    local bottom top
    bottom=$(ask_sheet "Sheet for the BOTTOM half") || return 0
    top=$(ask_sheet "Sheet for the TOP half") || return 0
    save pair "$top" "$bottom" 0
}

menu_web() {
    local items=() n choice
    for n in "${!WEB_URL[@]}"; do items+=("K$(kiosk_2d "$n")" "${WEB_NAME[n]:-Web page $n}"); done
    if [ ${#items[@]} -eq 0 ]; then
        whiptail --msgbox "club.conf has no web pages (WEB_URL). Add them in the club's site repo, then Software update." 12 70
        return 0
    fi
    choice=$(wt_menu "Web page" Back "${items[@]}") || return 0
    save web 0 0 "$((10#${choice:1:2}))"
}

menu_rotation() {
    local r
    r=$(wt_menu "How is this screen mounted? Choose a display next to apply it." Back \
        "H" "Horizontal (landscape)" "V" "Vertical (portrait)") || return 0
    ROTATION=$r
}

software_update() {
    whiptail --title "$WT_TITLE" --yesno "Fetch the latest kiosk software and club settings from GitHub, then reboot?" 10 70 || return 0
    if sudo kiosk-update; then
        echo; read -r -p "Update done. Press Enter to reboot. " _
        sudo reboot
    else
        echo; read -r -p "Update FAILED - see the messages above. Nothing was rebooted. Press Enter. " _
    fi
}

system_update() {
    sudo apt-get update && sudo apt-get -y upgrade && sudo apt-get -y autoremove
    echo; read -r -p "Press Enter to return to the menu. " _
}

main_menu() {
    local fun
    while true; do
        fun=$(wt_menu "Now showing: $(describe_current)" Quit \
            "P1"  "Two sheets (cameras)" \
            "P2"  "One sheet (cameras)"  \
            "P3"  "Any two sheets"       \
            "P4"  "Web page"             \
            "P5"  "Screen rotation"      \
            "P6"  "Software update"      \
            "P7"  "System update (apt)"  \
            "P8"  "Raspberry Pi config"  \
            "P9"  "Reboot") || return 0
        case "$fun" in
            P1) menu_pairs;;
            P2) menu_single;;
            P3) menu_custom;;
            P4) menu_web;;
            P5) menu_rotation;;
            P6) software_update;;
            P7) system_update;;
            P8) sudo raspi-config;;
            P9) whiptail --yesno "Reboot now?" 10 60 && sudo reboot;;
        esac
    done
}

main_menu
